# Backend only: use the Supabase transaction pooler URI in production.
# Escape special password characters for a URL (for example, @ becomes %40).
DATABASE_URL=postgresql+psycopg://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres
CORS_ORIGINS=http://localhost:5173

# Frontend variables are embedded in the browser bundle and MUST NOT contain secrets.
VITE_API_URL=http://localhost:8000
