APP_ENV=development
DATABASE_URL=sqlite:///./stockflow.db
REPORTING_TIMEZONE=Asia/Manila

SESSION_COOKIE_NAME=stockflow_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_EXPIRATION_HOURS=12

CORS_ORIGINS=http://localhost:5173
TRUSTED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30
PROXY_FORWARDED_ALLOW_IPS=127.0.0.1

# Browser-safe and optional. Unset means same-origin API requests.
VITE_API_URL=
