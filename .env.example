# Local development defaults. Copy to .env; never commit that file.
APP_ENV=development
DATABASE_URL=sqlite:///./stockflow.db
REPORTING_TIMEZONE=Asia/Manila
SESSION_COOKIE_NAME=stockflow_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_EXPIRATION_HOURS=12
CORS_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
TRUSTED_ORIGINS=http://localhost:5173
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30

# Browser-safe only; leave unset for a same-origin production build.
VITE_API_URL=http://localhost:8000
